{
  "name": "@apply/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy/index.d.ts",
      "default": "./dist/legacy/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "drizzle/legacy-migrations"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "tsc && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0"
  },
  "description": "Local offers cache of the desktop app (SQLite). Nothing else is stored locally."
}
